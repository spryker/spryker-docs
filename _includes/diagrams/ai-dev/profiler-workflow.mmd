flowchart TD
    Q(["Performance question"]) --> K{"Know which page<br/>is slow?"}
    K -->|"no"| W["Rank recorded profiles<br/>by queries, duplicates, memory"]
    K -->|"yes"| RP["Reproduce the request"]
    W --> RP

    RP --> RD["Read the profile<br/>check age is seconds, not days"]
    RD --> D{"Data present?"}
    D -->|"collector absent<br/>or no profiles"| SU["Enable the missing layer<br/>profiler · application plugin · collector"]
    SU --> RP

    D -->|"yes"| TR{"A page or action,<br/>or one endpoint?"}
    TR -->|"page or action"| TT["Trace the full tree<br/>entry + Zed calls + AJAX"]
    TR -->|"one endpoint"| CT
    TT --> CT["Read the counts,<br/>not the milliseconds"]

    CT --> N{"Counts high?"}
    N -->|"yes"| SC["Profile a small and a large entity<br/>does the count scale?"]
    SC --> FIX(["Report the shape:<br/>queries ≈ fixed + n × items"])
    N -->|"no"| CPU(["Counts fine but slow →<br/>userland CPU, use Xdebug"])
