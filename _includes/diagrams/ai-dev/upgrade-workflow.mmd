flowchart TD
    A(["Upgrade request"]) --> P0["<b>1 · Coverage check</b><br/>which customizations would notice<br/>if they stopped working?"]
    P0 --> T{"Override surface<br/>covered by tests?"}
    T -->|"gaps"| CT["Offer characterization tests<br/><i>must be written before the upgrade</i>"]
    CT --> P1
    T -->|"covered"| P1

    P1["<b>2 · Preflight and baselines</b><br/>snapshot overrides and shadowed files<br/>record pre-existing damage"]
    P1 --> P2["<b>3 · Constraint resolution</b><br/>relax patch-locked pins<br/>resolve conflicts in waves"]
    P2 --> COH{"Cohort deadlock?"}
    COH -->|"yes"| UNPIN["unpin feature-governed modules"]
    UNPIN --> P2
    COH -->|"no"| COMP["composer update"]

    COMP --> P3["<b>4 · Detection</b><br/>typed members · dead overrides<br/>shadowed twig · plugin stacks<br/>config constants · major bumps"]
    P3 --> P4["<b>5 · Resolution</b><br/>merge shadowed files · rewire stacks<br/>migration guide per major bump"]
    P4 --> DONE(["Resolving, verified upgrade"])

    P3 -.->|"reports"| ST[("`.spryker-upgrade/state/`")]
    P1 -.-> ST
